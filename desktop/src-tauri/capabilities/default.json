{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "main window: core apis, external links, spawn the bundled core",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "tgai-server",
          "sidecar": true,
          "args": ["--data-dir", { "validator": ".*" }, "--parent-pid", { "validator": "\\d+" }]
        }
      ]
    }
  ]
}
